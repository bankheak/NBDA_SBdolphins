after_wean$euclid_dist_fg <- sqrt((after_wean$freq_calf_fg - after_wean$freq_mom_fg)^2)
after_wean$euclid_dist_sd <- sqrt((after_wean$freq_calf_sd - after_wean$freq_mom_sd)^2)
