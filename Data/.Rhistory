# Transform to similarity
# Normalize Euclidian distances to make it range [0,1] and then simply apply 1-normalized distance
sim_eu <- function(value) {
normdistance <- value / max(value)
# similarity [0,1] = 1 - distance[0,1]
similarity1 = 1-normdistance
return(similarity1)
}
tmp <- aggregate(tmp, list(sim_calf_bg = euclid_dist_bg,
sim_calf_bg = euclid_dist_fg,
sim_calf_bg = euclid_dist_sd,), sim_eu)
# Transform to similarity
# Normalize Euclidian distances to make it range [0,1] and then simply apply 1-normalized distance
sim_eu <- function(value) {
m <- max(value, na.rm = TRUE)
if (is.na(m) || m == 0) return(rep(0, length(value)))
1 - (value / m)
}
tmp$sim_calf_bg <- sim_eu(tmp$euclid_dist_bg)
tmp$sim_calf_fg <- sim_eu(tmp$euclid_dist_fg)
tmp$sim_calf_sd <- sim_eu(tmp$euclid_dist_sd)
hist(tmp$sim_calf_bg)
hist(tmp$sim_calf_fg)
hist(tmp$sim_calf_sd)
hc_mom_freq
