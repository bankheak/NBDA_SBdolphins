# Create a frequency use function
hc_freq_use <- function(df) {
hc_behavs <- table(df$Code, df$DiffHI)
hc_behavs_freq <- data.frame(Code = row.names(hc_behavs),
Freq_bg = hc_behavs[,1]/rowSums(hc_behavs),
Freq_fg = hc_behavs[,2]/rowSums(hc_behavs),
Freq_sd = hc_behavs[,4]/rowSums(hc_behavs))
return(hc_behavs_freq)
}
