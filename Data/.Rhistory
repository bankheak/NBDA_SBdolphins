BirthYear = as.integer(BirthYear)
) %>%
group_by(Mom, BirthYear) %>%
summarise(n_calves = n(), .groups = "drop")
View(calves_by_mom_year)
# 2) Prepare calv_succ IDs/years for merging and consistent types
seen_ids_years <- calv_succ %>%
mutate(
Code = as.character(Code),
Year = as.integer(Year)
) %>%
distinct(Code, Year)
View(seen_ids_years)
# 3) Join seen years to calf counts (left join keeps all seen Code-Year pairs)
calves_per_code_year <- seen_ids_years %>%
left_join(calves_by_mom_year, by = c("Code" = "Mom", "Year" = "BirthYear")) %>%
mutate(n_calves = coalesce(n_calves, 0L)) %>%
arrange(Code, Year)
View(calves_per_code_year)
View(calves_by_mom_year)
View(calves_by_mom_year)
