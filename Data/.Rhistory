}
# Lambda
Ntotal <- colSums(N)
N_t <- Ntotal[1:30]
N_t1 <- Ntotal[2:31]
lambda <- N_t1/N_t
# Proportions
AgeStr <- proportions(N, 2)
# Final lambda and props
final_lambda_2 <- lambda[30]
stable_age_dist_2 <- AgeStr[,31]
# Compare
final_lambda_orig
final_lambda_2
## The same
stable_age_dist_orig
stable_age_dist_2
