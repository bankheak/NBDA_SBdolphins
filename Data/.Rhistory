# Chunk 1: setup
knitr::opts_chunk$set(echo = TRUE)
# Chunk 2
# N = c(...)
N0 <- c(16, # 16 newborns
0, # no 1-year olds
0, # no 2-year olds
0, # no 3-year olds
4) # 4 adults
# Chunk 3
# Surv = c(...) # for organization it is helpful to make this be a vector with the appropriate number of entries, instead of lots of separate variables
Surv <- data.frame(new = 0.5, one = 0.75,
two = 0.75, three = 0.75,
adult = 0.8)
fecund <- 4
# Chunk 4
# Adults and subadults can reproduce
## Adults
adult_fert <- Surv$adult * fecund
## Subadults
three_fert <- Surv$three * fecund
# Chunk 5
#L = matrix(data = 0, nrow = 3, ncol = 3) # this makes a blank 3x3 matrix with zero for every entry
#L[2,1] = 0.5 # this inserts the value 5 into the second row, first column of L
L <- matrix(0, 5, 5)
# Newborn survival
L[2, 1] <- Surv$new
# One-year old survival
L[3, 2] <- Surv$one
# Two-year old survival
L[4, 3] <- Surv$two
# Three-year old survival
L[5, 4] <- Surv$three
# Adult survival
L[5, 5] <- Surv$adult
# Three-year old fertility
L[1, 4] <- three_fert
# Adult fertility
L[1, 5] <- adult_fert
colnames(L) <- c("Newborn", "1-Year", "2-Year", "3-Year", "Adult")
rownames(L) <- c("Newborn", "1-Year", "2-Year", "3-Year", "Adult")
L
# Bonus, if you want extra experience with matrices in R:
# For large matrices (more than 4 age classes) it is useful to use the diag() function to insert values along the diagonal of a matrix. Of course this is a little tricky for age-structured models because the values need to be just below the diagonal, not on the diagonal. But in this 3x3 example you could do this:
# L[2:3,1:2] = diag(Surv) # put the survivals on the off-diagonal
# L[1,] = Fert # put the vector of fertilities on the top row
# Chunk 6
# N = matrix(0,nrow = , ncol = ) # specify the correct number of rows and columns for the population matrix
# N[,1] = ... # insert the starting conditions we provided earlier
# N[,t] = L %*% N[,t-1] # your loop will have an operation like this that advances the model from t-1 to t
N <- matrix(0, 5, 31)
N[,1] <- N0
for (i in 1:30) {
N[ , i + 1] <- L %*% N[ , i]
}
# Chunk 7
#Ntotal = colSums(N). # then use this variable to calculate Lambda for each year
#AgeStr = proportions(N,margin = 2) # the margin = 2 argument tells it to calculate the proportion by columns (i.e., for each year)
#barplot(AgeStr) # this is the simplest way to plot the proportional age structure over time; experiment with options to label axes, etc.
Ntotal <- colSums(N)
N_t <- Ntotal[1:30]
N_t1 <- Ntotal[2:31]
lambda <- N_t1/N_t
# for loop method
AgeStr <- matrix(0, 5, 31)
for (i in 1:31) {
AgeStr[, i] <- N[, i]/Ntotal[i]
}
# proportions
AgeStr <- proportions(N, 2)
# Graphs through time
time <- 1:31
## Total N
plot(time, Ntotal, ylab = "Total Population", xlab = "Time (years)")
## Lambda
time <- 1:30
plot(time, lambda, ylab = "Lambda", xlab = "Time (years)")
## Proportions
time <- 1:31
cols <- c("red", "green", "orange", "pink", "blue")
barplot(AgeStr, col = cols)
legend("topright",
legend = c("Newborn", "1-Year", "2-Year", "3-Year", "Adult"),
fill = cols,
title = "Age Structure")
# Chunk 8
final_lambda_orig <- lambda[30]
stable_age_dist_orig <- AgeStr[,31]
# Chunk 9
