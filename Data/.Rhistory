# Set relative path working directory
setwd("../Data")
set.seed(123)
n <- 10000  # smaller example dataset
fake_data <- data.frame(
X.1 = 1:n,
X = 1:n,
SightingFID = sample(10000:30000, n, replace = TRUE),
Date = as.character(
sample(
seq(as.Date("1995-01-01"),
as.Date("2023-12-31"),
by = "day"),
n,
replace = TRUE
)
),
StartTime = sprintf(
"%02d:%02d",
sample(6:18, n, replace = TRUE),
sample(c(0,15,30,45), n, replace = TRUE)
),
EndTime = sprintf(
"%02d:%02d",
sample(6:19, n, replace = TRUE),
sample(c(0,15,30,45), n, replace = TRUE)
),
SurveyNum = sample(1000:6000, n, replace = TRUE),
SurveyType = sample(
c("Photo-id (Pop Mon)",
"No Data",
"Behavior Survey",
"Health Assessment"),
n,
replace = TRUE,
prob = c(0.7, 0.1, 0.15, 0.05)
),
SurveyArea = sample(
c("SB","NB","CB",""),
n,
replace = TRUE,
prob = c(0.5,0.2,0.2,0.1)
),
Subarea = sample(
c("AMG","RBC","SAR","VEN","LKB","PAS"),
n,
replace = TRUE
),
StartLat = round(runif(n, 27.1, 27.9), 5),
StartLon = round(runif(n, -82.9, -82.2), 5),
Sighting = as.character(sample(1:1000, n, replace = TRUE)),
Effort = sample(
c("Photo-id (Pop Mon)",
"Focal Follow",
"No Data"),
n,
replace = TRUE
),
TDolphinBest = sample(1:30, n, replace = TRUE),
TCalfBest = sample(0:10, n, replace = TRUE),
Behaviors = sample(
c("Travel",
"Forage",
"Socialize",
"Rest",
"Mill"),
n,
replace = TRUE
),
HumanInteraction = sample(
c("999","FG","HL","Boating","Feeding"),
n,
replace = TRUE,
prob = c(0.8,0.08,0.08,0.03,0.01)
),
Code = paste0(
sample(c("F","FB","C","D"), n, replace = TRUE),
sample(100:999, n, replace = TRUE)
),
SightingNotes = "",
ConfHI = sample(
c("0","FG","HL"),
n,
replace = TRUE,
prob = c(0.9,0.05,0.05)
),
PossHI = sample(
c("0","FG","HL"),
n,
replace = TRUE,
prob = c(0.85,0.075,0.075)
),
Confirmed_HI = sample(
c(0,1),
n,
replace = TRUE,
prob = c(0.9,0.1)
)
)
# Derive time-related variables
fake_data$Year <- as.integer(format(as.Date(fake_data$Date), "%Y"))
fake_data$MonthIndex <- sample(1:348, n, replace = TRUE)
fake_data$DiffHI <- sample(
c("None","FG","SD"),
n,
replace = TRUE,
prob = c(0.7,0.15,0.1,0.05)
)
fake_data$DiffHI <- sample(
c("None","FG","SD","Both"),
n,
replace = TRUE,
prob = c(0.7,0.15,0.1,0.05)
)
fake_data$sixmon <- sample(1:58, n, replace = TRUE)
str(fake_data)
View(fake_data)
